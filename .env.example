APP_ENV=staging
APP_NAME=Everpay API
LOG_LEVEL=INFO
API_DOCS_ENABLED=false
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
REDIS_URL=redis://:REPLACE_WITH_A_LONG_RANDOM_SECRET@redis:6379/0
# CockroachDB is external to this Compose file. Use a dedicated TLS-enabled staging cluster.
DATABASE_URL=postgresql://everpay_fastapi_staging:REPLACE_WITH_SQL_PASSWORD@REPLACE_WITH_STAGING_HOST:26257/everpay_staging?sslmode=verify-full
# Keep processor, VGS and Supabase service credentials in a secrets manager, not this file.
