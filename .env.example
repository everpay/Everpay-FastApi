APP_NAME=Everpay API
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/v1
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/DATABASE?ssl=verify-full
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
AUTH_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_TIMEOUT_SECONDS=12
DIDIT_SDK_TOKEN_TTL_SECONDS=900
DIDIT_SDK_TOKEN_MAX_PER_MINUTE=5
DIDIT_WEBHOOK_TOLERANCE_SECONDS=300
DIDIT_WEBHOOK_MAX_BODY_BYTES=262144
# AiPrise KYC/KYB. Keep all credentials server-side; do not use VITE_ prefixes.
AIPRISE_API_KEY=
AIPRISE_SECONDARY_FALLBACK_ENABLED=false
AIPRISE_WEBHOOK_SECRET=
AIPRISE_BASE_URL=https://api-sandbox.aiprise.com/api/v1/verify
AIPRISE_ENVIRONMENT=sandbox
AIPRISE_TIMEOUT_SECONDS=20
AIPRISE_KYC_TEMPLATE_ID=
AIPRISE_EMAIL_CHECK_TEMPLATE_ID=
AIPRISE_PHONE_CHECK_TEMPLATE_ID=
AIPRISE_KYB_TEMPLATE_ID=
AIPRISE_CALLBACK_BASE_URL=https://api.everpayinc.com/v1
AIPRISE_WEBHOOK_MAX_BODY_BYTES=1048576
# Didit is Everpay's PRIMARY KYC, KYB and transaction-monitoring provider.
# Configure the stable workflow_id values from the LIVE Didit application.
DIDIT_KYC_WORKFLOW_ID=
DIDIT_KYB_WORKFLOW_ID=
DIDIT_VERIFICATION_WEBHOOK_SECRET=
DIDIT_CALLBACK_BASE_URL=https://api.everpayinc.com/v1
