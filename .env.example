APP_NAME=Everpay API
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/DATABASE?ssl=verify-full
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
AUTH_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_TIMEOUT_SECONDS=12
DIDIT_SDK_TOKEN_TTL_SECONDS=900
DIDIT_SDK_TOKEN_MAX_PER_MINUTE=5
DIDIT_WEBHOOK_TOLERANCE_SECONDS=300
DIDIT_WEBHOOK_MAX_BODY_BYTES=262144
