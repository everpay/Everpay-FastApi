APP_ENV=staging
APP_NAME=Everpay API
LOG_LEVEL=INFO
API_DOCS_ENABLED=false
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
REDIS_URL=redis://:REPLACE_WITH_A_LONG_RANDOM_SECRET@redis:6379/0
# CockroachDB is external to this Compose file. Use a dedicated TLS-enabled staging cluster.
DATABASE_URL=postgresql://everpay_fastapi_staging:REPLACE_WITH_SQL_PASSWORD@REPLACE_WITH_STAGING_HOST:26257/everpay_staging?sslmode=verify-full
# Keep processor, VGS and Supabase service credentials in a secrets manager, not this file.
# Fraud graph (optional). Recording stays off until both are set.
# Same value as the FRAUD_GRAPH_HMAC_KEY secret on the Supabase edge functions (32+ random bytes).
FRAUD_GRAPH_HMAC_KEY=REPLACE_WITH_THE_SHARED_FRAUD_GRAPH_KEY
# Supabase login that is a member of fraud_graph_writer. Mount the Supabase root certificate and point sslrootcert at it.
SUPABASE_DATABASE_URL=postgresql://everpay_fastapi.REPLACE_PROJECT_REF:REPLACE_PASSWORD@REPLACE_POOLER_HOST:6543/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-root.crt
